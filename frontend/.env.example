# Starehian Society Platform - Environment Configuration
# Copy this file to .env and fill in your values

# ─── Go Backend API Configuration ────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000/api
VITE_API_TIMEOUT=30000

# ─── Fineract API Configuration (Legacy - can be removed) ──────────────────────────
VITE_FINERACT_BASE_URL=https://banking.siohioma.com/fineract-provider/api/v1
VITE_FINERACT_TENANT_ID=default

# ─── M-Pesa Configuration ───────────────────────────────────────────────────────
VITE_MPESA_BASE_URL=https://204.168.218.166:8081
VITE_MPESA_SHORTCODE=your_shortcode
VITE_MPESA_PASSKEY=your_passkey
VITE_MPESA_CONSUMER_KEY=your_consumer_key
VITE_MPESA_CONSUMER_SECRET=your_consumer_secret

# ─── Payment Gateway Configuration ───────────────────────────────────────────────
# Pesalink & RTGS Configuration
VITE_PESALINK_ENABLED=true
VITE_RTGS_ENABLED=true
VITE_BANK_TRANSFER_ENABLED=true

# ─── Email Configuration ────────────────────────────────────────────────────────
VITE_EMAIL_RENDERER_URL=http://localhost:3002
VITE_EMAIL_FROM=noreply@siohioma.com
VITE_EMAIL_REPLY_TO=support@siohioma.com
RESEND_API_KEY=your_resend_api_key

# ─── Application Configuration ───────────────────────────────────────────────────
VITE_APP_NAME=Siohioma SACCO
VITE_APP_VERSION=1.0.0
VITE_SESSION_TIMEOUT_MINUTES=30

# ─── Security Configuration ────────────────────────────────────────────────────
VITE_MAX_LOGIN_ATTEMPTS=5
VITE_OTP_EXPIRY_MINUTES=10
VITE_PIN_MAX_ATTEMPTS=3

# ─── Loan Configuration ────────────────────────────────────────────────────────
VITE_LOAN_PROCESSING_FEE=500
VITE_LOAN_MIN_AMOUNT=5000
VITE_LOAN_MAX_AMOUNT=3000000

# ─── Transfer Configuration ────────────────────────────────────────────────────
VITE_TRANSFER_MIN_AMOUNT=50
VITE_TRANSFER_MAX_AMOUNT=1000000
