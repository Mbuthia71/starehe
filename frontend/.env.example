# Starehian Society Alumni Platform - Environment Configuration
# Copy this file to .env.local and fill in your values

# ─── Go Backend API Configuration ────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000/api
VITE_API_TIMEOUT=30000

# ─── Centrifugo Real-time Configuration ─────────────────────────────────────────────
VITE_CENTRIFUGO_WS_URL=ws://localhost:8000/connection/websocket
VITE_CENTRIFUGO_API_KEY=your-centrifugo-api-key

# ─── Application Configuration ───────────────────────────────────────────────────
VITE_APP_NAME=Old Starehian Society
VITE_APP_VERSION=1.0.0
VITE_SESSION_TIMEOUT_MINUTES=30

# ─── Security Configuration ────────────────────────────────────────────────────
VITE_MAX_LOGIN_ATTEMPTS=5
VITE_OTP_EXPIRY_MINUTES=10

# ─── Feature Flags ─────────────────────────────────────────────────────────────
VITE_ENABLE_MESSAGING=true
VITE_ENABLE_REAL_TIME=true
VITE_ENABLE_NOTIFICATIONS=true
